PORT=3000
NODE_ENV=development
# Obligatorio en producción. Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Usuarios admin (separados por coma) y contraseña inicial. Solo se usa al crear el usuario.
ADMIN_USERS=Robert,Monica
ADMIN_PASSWORD=
DB_PATH=./data.db
# Token que Vapi envía en Authorization: Bearer <token>
VAPI_WEBHOOK_TOKEN=
# mock | network | usb
PRINTER_MODE=mock
PRINTER_INTERFACE=tcp://192.168.1.100:9100
# Orígenes CORS permitidos (vacío = solo mismo origen)
CORS_ORIGIN=
