{
  "name": "sistema-pedidos-restaurante",
  "version": "2.0.0",
  "description": "Sistema de pedidos web + voz (Vapi) + impresora ESC/POS",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:web": "npm run dev --prefix web",
    "build": "npm ci --prefix web && npm run build --prefix web",
    "test": "node --test server/test/orders.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "optionalDependencies": {
    "node-thermal-printer": "^4.4.4"
  },
  "engines": {
    "node": ">=18"
  }
}
